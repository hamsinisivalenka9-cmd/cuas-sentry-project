# =====================================================
# SOURCE DATA
# =====================================================

# Never commit the source MCAP file (CLAUDE.md rule 2). It was
# previously committed by mistake in commit d3df408 and has since been
# purged from git history (see docs/stages/STAGE_09_UI_AND_NAVIGATION_SUMMARY.txt).
data/input/*
!data/input/.gitkeep


# =====================================================
# GENERATED OUTPUT
# =====================================================

# Ignore generated output by default
data/output/*
!data/output/.gitkeep


# =====================================================
# PYTHON
# =====================================================

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/


# =====================================================
# ENVIRONMENT
# =====================================================

.env
.env.*


# =====================================================
# IDE / OS
# =====================================================

.DS_Store
.vscode/settings.json


# =====================================================
# DATABASES
# =====================================================

# Ignore databases everywhere -- including the generated final database,
# data/output/sentry.db (CLAUDE.md rule 2: never commit the generated
# SQLite database).
*.db
*.sqlite
*.sqlite3


# =====================================================
# LOGS
# =====================================================

*.log