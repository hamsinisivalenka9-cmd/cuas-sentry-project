# =====================================================
# SOURCE DATA
# =====================================================

# sanitized.mcap is intentionally tracked (explicit override of
# CLAUDE.md rule 2, requested 2026-08-10) so the repository is
# self-contained. It was previously committed by mistake in commit
# d3df408 and purged from history (see
# docs/stages/STAGE_09_UI_AND_NAVIGATION_SUMMARY.txt) -- this is a
# deliberate re-commit, not a repeat of that mistake.


# =====================================================
# GENERATED OUTPUT
# =====================================================

# Ignore generated output by default
data/output/*
!data/output/.gitkeep


# =====================================================
# PYTHON
# =====================================================

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/


# =====================================================
# ENVIRONMENT
# =====================================================

.env
.env.*


# =====================================================
# IDE / OS
# =====================================================

.DS_Store
.vscode/settings.json


# =====================================================
# DATABASES
# =====================================================

# Ignore databases everywhere -- including the generated final database,
# data/output/sentry.db (CLAUDE.md rule 2: never commit the generated
# SQLite database).
*.db
*.sqlite
*.sqlite3


# =====================================================
# LOGS
# =====================================================

*.log


# =====================================================
# SUBMISSION PACKAGING
# =====================================================

# The final submission archive is a generated packaging artifact (a
# snapshot of the repo at pack time) -- not source, and stale the
# moment anything else changes. Never committed.
Hamsini_Sivalenka.zip